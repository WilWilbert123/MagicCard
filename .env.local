# ========================================================
# ENTERPRISE ID CARD & KIOSK PLATFORM CONFIGURATION
# ========================================================

# Supabase Public Configuration (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Privileged Configuration (Server-Only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Local KIOSK Hardware Agent Configuration
NEXT_PUBLIC_KIOSK_AGENT_URL=http://127.0.0.1:7125
KIOSK_AGENT_PORT=7125
KIOSK_AGENT_SECRET=super-secret-local-agent-token-2026

# MagicCard Trust ID Hardware Mode
# Set to true for development simulation, false for physical production printer
MOCK_PRINT=true
MAGICCARD_TRUST_ID_MODE=CLI_DIRECT
MAGICCARD_TRUST_ID_PATH=C:\Program Files\Magicard\TrustID\TrustID.exe
MAGICCARD_TRUST_ID_CONFIG=C:\ProgramData\Magicard\TrustID\config.json
PRINTER_NAME=Magicard 300 Duo
